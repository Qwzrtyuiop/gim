; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gulong"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
config/enable_debug_shortcuts=false

[autoload]

InputBindings="*res://scripts/input_bindings.gd"
AudioSettingsManager="*res://scripts/audio_settings_manager.gd"
StoryLanguageManager="*res://scripts/story_language_manager.gd"
PlayerState="*res://scripts/player_state.gd"
SaveSlotManager="*res://scripts/save/save_slot_manager.gd"
AmbientAudioManager="*res://scripts/audio/ambient_audio_manager.gd"
HubMusicManager="*res://scripts/audio/hub_music_manager.gd"
AchievementPopupManager="*res://scripts/ui/achievement_popup_manager.gd"
PauseMenuManager="*res://scripts/ui/pause_menu_manager.gd"
UIAudioManager="*res://scripts/ui/ui_audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
